 				params.delta_time = float(time_step);
-				params.reset_accumulation = false; // FIXME: The engine does not provide a way to reset the accumulation.
+				params.reset_accumulation = rb->get_reset_accumulation(); // Set on reconfigure and by RenderingServer.viewport_reset_accumulation().
 
 				Projection correction;
 				correction.set_depth_correction(true, true, false);
@@ -2539,7 +2563,7 @@ void RenderForwardClustered::_render_scene(RenderDataRD *p_render_data, const Co
 				params.exposure = exposure;
