 }
 
+void RenderSceneBuffersRD::ensure_color_opaque() {
+	if (!has_texture(RB_SCOPE_BUFFERS, RB_TEX_COLOR_OPAQUE)) {
+		uint32_t usage_bits = RD::TEXTURE_USAGE_SAMPLING_BIT | (can_be_storage ? RD::TEXTURE_USAGE_STORAGE_BIT : 0) | RD::TEXTURE_USAGE_COLOR_ATTACHMENT_BIT;
+		create_texture(RB_SCOPE_BUFFERS, RB_TEX_COLOR_OPAQUE, get_base_data_format(), usage_bits);
+	}
+}
+
