+void RendererViewport::viewport_reset_accumulation(RID p_viewport) {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL(viewport);
+
+	// Consumed by the next 3D draw of this viewport (temporal upscalers drop their history for one frame).
+	viewport->reset_accumulation = true;
+}
