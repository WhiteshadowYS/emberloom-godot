@@ -2417,6 +2417,30 @@ void RenderForwardClustered::_render_scene(RenderDataRD *p_render_data, const Co
 		_process_compositor_effects(RSE::COMPOSITOR_EFFECT_CALLBACK_TYPE_PRE_TRANSPARENT, p_render_data);
 	}
 
+	if (rb_data.is_valid() && scale_type == SCALE_CUSTOM && rb->has_internal_texture() && RSG::viewport->viewport_upscaler_get_requires_opaque_color(custom_upscaler)) {
+		// Opaque-only colour for the custom upscaler (auto-reactive / transparency-and-composition masks):
+		// a copy of the colour buffer after the opaque pass, sky and pre-transparent effects, before transparents.
+		RENDER_TIMESTAMP("Copy Opaque Color");
+		RD::get_singleton()->draw_command_begin_label("Copy Opaque Color");
+
+		rb->ensure_color_opaque();
+		bool can_use_storage = _render_buffers_can_be_storage();
+		Size2i internal_size = rb->get_internal_size();
+		for (uint32_t v = 0; v < rb->get_view_count(); v++) {
+			if (use_msaa) {
+				RD::get_singleton()->texture_resolve_multisample(rb->get_color_msaa(v), rb->get_internal_texture(v));
+			}
+			RID dest = rb->get_texture_slice(RB_SCOPE_BUFFERS, RB_TEX_COLOR_OPAQUE, v, 0);
+			if (can_use_storage) {
+				copy_effects->copy_to_rect(rb->get_internal_texture(v), dest, Rect2i(Point2i(), internal_size));
+			} else {
+				copy_effects->copy_to_fb_rect(rb->get_internal_texture(v), FramebufferCacheRD::get_singleton()->get_cache(dest), Rect2i(Point2i(), internal_size));
+			}
+		}
+
+		RD::get_singleton()->draw_command_end_label();
+	}
+
 	RENDER_TIMESTAMP("Render 3D Transparent Pass");
 
 	RD::get_singleton()->draw_command_begin_label("Render 3D Transparent Pass");
