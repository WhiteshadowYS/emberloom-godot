 	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS, ERR_CANT_CREATE, vformat("Couldn't create Vulkan swapchain (VkResult error %d).", err));
 
@@ -7495,6 +7623,121 @@ RenderingDeviceDriverVulkan::RenderingDeviceDriverVulkan(RenderingContextDriverV
 	max_descriptor_sets_per_pool = GLOBAL_GET("rendering/rendering_device/vulkan/max_descriptors_per_pool");
 }
 
+/*********************/
+/**** LOW LATENCY ****/
+/*********************/
+
+// emberloom-godot L1: VK_AMD_anti_lag (AMD Windows, RADV) and VK_NV_low_latency2 (NVIDIA).
+// The OS main loop raises the input marker right before input is processed (Anti-Lag input stage /
+// NV latency sleep + simulation start); the renderer raises the render-start marker; the present
+// stage is issued from command_queue_execute_and_present(). Meant for the single-threaded
+// (Safe) rendering thread model: the input marker holds the low latency mutex while it sleeps.
+
+void RenderingDeviceDriverVulkan::_low_latency_amd_update(VkAntiLagStageAMD p_stage, uint64_t p_frame) {
+	VkAntiLagPresentationInfoAMD presentation_info = {};
+	presentation_info.sType = VK_STRUCTURE_TYPE_ANTI_LAG_PRESENTATION_INFO_AMD;
+	presentation_info.stage = p_stage;
+	presentation_info.frameIndex = p_frame;
+	VkAntiLagDataAMD data = {};
+	data.sType = VK_STRUCTURE_TYPE_ANTI_LAG_DATA_AMD;
+	data.mode = VK_ANTI_LAG_MODE_ON_AMD;
+	data.maxFPS = 0; // The engine's own max_fps limiter stays in charge.
+	data.pPresentationInfo = &presentation_info;
+	low_latency.AntiLagUpdateAMD(vk_device, &data);
+}
+
+void RenderingDeviceDriverVulkan::_low_latency_nv_marker(VkLatencyMarkerNV p_marker, uint64_t p_present_id) {
+	// Caller holds low_latency.mutex.
+	if (low_latency.nv_swapchain == VK_NULL_HANDLE || p_present_id == 0) {
+		return;
+	}
+	VkSetLatencyMarkerInfoNV marker_info = {};
+	marker_info.sType = VK_STRUCTURE_TYPE_SET_LATENCY_MARKER_INFO_NV;
+	marker_info.presentID = p_present_id;
+	marker_info.marker = p_marker;
+	low_latency.SetLatencyMarkerNV(vk_device, low_latency.nv_swapchain, &marker_info);
+}
+
+void RenderingDeviceDriverVulkan::_low_latency_nv_apply_mode() {
+	// Caller holds low_latency.mutex.
+	if (!low_latency.nv_mode_dirty || low_latency.nv_swapchain == VK_NULL_HANDLE) {
+		return;
+	}
+	VkLatencySleepModeInfoNV sleep_mode_info = {};
+	sleep_mode_info.sType = VK_STRUCTURE_TYPE_LATENCY_SLEEP_MODE_INFO_NV;
+	sleep_mode_info.lowLatencyMode = low_latency.enabled ? VK_TRUE : VK_FALSE;
+	sleep_mode_info.lowLatencyBoost = VK_FALSE;
+	sleep_mode_info.minimumIntervalUs = 0;
+	VkResult err = low_latency.SetLatencySleepModeNV(vk_device, low_latency.nv_swapchain, &sleep_mode_info);
+	if (err != VK_SUCCESS) {
+		WARN_PRINT_ONCE(vformat("vkSetLatencySleepModeNV failed (VkResult error %d).", err));
+	}
+	low_latency.nv_mode_dirty = false;
+}
+
+bool RenderingDeviceDriverVulkan::low_latency_is_supported() {
+	return low_latency.amd_supported || low_latency.nv_supported;
+}
+
+void RenderingDeviceDriverVulkan::low_latency_set_enabled(bool p_enabled) {
+	MutexLock lock(low_latency.mutex);
+	const bool enabled = p_enabled && (low_latency.amd_supported || low_latency.nv_supported);
+	if (enabled == low_latency.enabled) {
+		return;
+	}
+	low_latency.enabled = enabled;
+	if (low_latency.amd_supported && !enabled) {
+		VkAntiLagDataAMD data = {};
+		data.sType = VK_STRUCTURE_TYPE_ANTI_LAG_DATA_AMD;
+		data.mode = VK_ANTI_LAG_MODE_OFF_AMD;
+		low_latency.AntiLagUpdateAMD(vk_device, &data);
+	}
+	if (low_latency.nv_supported) {
+		low_latency.nv_mode_dirty = true;
+		_low_latency_nv_apply_mode();
+	}
+}
+
+void RenderingDeviceDriverVulkan::low_latency_marker(LowLatencyMarker p_marker) {
+	MutexLock lock(low_latency.mutex);
+	if (!low_latency.enabled) {
+		return;
+	}
+	switch (p_marker) {
+		case LOW_LATENCY_MARKER_INPUT: {
+			const uint64_t frame = ++low_latency.frame_id;
+			if (low_latency.amd_supported) {
+				// The driver delays here so that input is sampled as late as the GPU allows.
+				_low_latency_amd_update(VK_ANTI_LAG_STAGE_INPUT_AMD, frame);
+			}
+			if (low_latency.nv_supported && low_latency.nv_swapchain != VK_NULL_HANDLE) {
+				const uint64_t value = ++low_latency.nv_semaphore_value;
+				VkLatencySleepInfoNV sleep_info = {};
+				sleep_info.sType = VK_STRUCTURE_TYPE_LATENCY_SLEEP_INFO_NV;
+				sleep_info.signalSemaphore = low_latency.nv_semaphore;
+				sleep_info.value = value;
+				if (low_latency.LatencySleepNV(vk_device, low_latency.nv_swapchain, &sleep_info) == VK_SUCCESS) {
+					VkSemaphoreWaitInfo wait_info = {};
+					wait_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO;
+					wait_info.semaphoreCount = 1;
+					wait_info.pSemaphores = &low_latency.nv_semaphore;
+					wait_info.pValues = &value;
+					// Never stall a frame for long if the driver does not signal (50 ms cap).
+					low_latency.WaitSemaphores(vk_device, &wait_info, 50'000'000);
+				}
+				_low_latency_nv_marker(VK_LATENCY_MARKER_SIMULATION_START_NV, frame);
+				_low_latency_nv_marker(VK_LATENCY_MARKER_INPUT_SAMPLE_NV, frame);
+			}
+		} break;
+		case LOW_LATENCY_MARKER_RENDER_START: {
+			if (low_latency.nv_supported && low_latency.frame_id > low_latency.presented_frame_id) {
+				_low_latency_nv_marker(VK_LATENCY_MARKER_SIMULATION_END_NV, low_latency.frame_id);
+				_low_latency_nv_marker(VK_LATENCY_MARKER_RENDERSUBMIT_START_NV, low_latency.frame_id);
+			}
+		} break;
+	}
+}
+
 RenderingDeviceDriverVulkan::~RenderingDeviceDriverVulkan() {
 #if defined(DEBUG_ENABLED) || defined(DEV_ENABLED)
 	if (breadcrumb_buffer != BufferID()) {
@@ -7519,6 +7762,10 @@ RenderingDeviceDriverVulkan::~RenderingDeviceDriverVulkan() {
 	}
 
 	if (vk_device != VK_NULL_HANDLE) {
+		if (low_latency.nv_semaphore != VK_NULL_HANDLE) {
+			vkDestroySemaphore(vk_device, low_latency.nv_semaphore, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SEMAPHORE));
+			low_latency.nv_semaphore = VK_NULL_HANDLE;
+		}
 		vkDestroyDevice(vk_device, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_DEVICE));
 	}
 }
diff --git a/drivers/vulkan/rendering_device_driver_vulkan.h b/drivers/vulkan/rendering_device_driver_vulkan.h
index 6d17386d4e..dd39aff036 100644
--- a/drivers/vulkan/rendering_device_driver_vulkan.h
+++ b/drivers/vulkan/rendering_device_driver_vulkan.h
@@ -168,6 +168,33 @@ class RenderingDeviceDriverVulkan : public RenderingDeviceDriver {
 	bool pipeline_cache_control_support = false;
 	bool device_fault_support = false;
 	bool framebuffer_depth_resolve = false;
+
+	// Low latency (emberloom-godot L1). Requested through the P4 project setting
