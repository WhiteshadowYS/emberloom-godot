diff --git a/servers/rendering/rendering_device.cpp b/servers/rendering/rendering_device.cpp
index 7574038788..1eab426e8d 100644
--- a/servers/rendering/rendering_device.cpp
+++ b/servers/rendering/rendering_device.cpp
@@ -1235,6 +1235,40 @@ Error RenderingDevice::driver_callback_add(RDD::DriverCallback p_callback, void
 	return OK;
 }
 
+void RenderingDevice::_driver_callback_call(RenderingDeviceDriver *p_driver, RDD::CommandBufferID p_command_buffer, void *p_userdata) {
+	// Runs while the render graph is recorded into the native command buffer, once per driver_callback_add().
+	Callable *callback = (Callable *)p_userdata;
+	uint64_t native_command_buffer = p_driver->get_resource_native_handle(DRIVER_RESOURCE_COMMAND_BUFFER, p_command_buffer);
+	callback->call(int64_t(native_command_buffer));
+	memdelete(callback);
+}
+
+Error RenderingDevice::_driver_callback_add_bind(const Callable &p_callback, const TypedArray<RID> &p_resources, const Vector<int32_t> &p_resource_types, const Vector<int32_t> &p_resource_usages) {
+	ERR_FAIL_COND_V(!p_callback.is_valid(), ERR_INVALID_PARAMETER);
+	// Vulkan only: the D3D12 driver caches bound PSO / root signature / descriptor heaps on the command buffer
+	// (a native SDK would invalidate them behind its back) and skips graph barriers without enhanced barriers.
+	ERR_FAIL_COND_V_MSG(get_device_api_name() != "Vulkan", ERR_UNAVAILABLE, "driver_callback_add is only supported on Vulkan.");
+	ERR_FAIL_COND_V_MSG(p_resource_types.size() != p_resources.size() || p_resource_usages.size() != p_resources.size(), ERR_INVALID_PARAMETER,
+			"resources, resource_types and resource_usages must have the same size.");
+
+	LocalVector<CallbackResource> resources;
+	resources.resize(p_resources.size());
+	for (int i = 0; i < p_resources.size(); i++) {
+		ERR_FAIL_INDEX_V(p_resource_types[i], CALLBACK_RESOURCE_TYPE_BUFFER + 1, ERR_INVALID_PARAMETER);
+		ERR_FAIL_INDEX_V(p_resource_usages[i], CALLBACK_RESOURCE_USAGE_MAX, ERR_INVALID_PARAMETER);
+		resources[i].rid = p_resources[i];
+		resources[i].type = CallbackResourceType(p_resource_types[i]);
+		resources[i].usage = CallbackResourceUsage(p_resource_usages[i]);
+	}
+
+	Callable *callback = memnew(Callable(p_callback));
+	Error err = driver_callback_add(&RenderingDevice::_driver_callback_call, callback, resources);
+	if (err != OK) {
+		memdelete(callback);
+	}
+	return err;
+}
+
