+	BIND_ENUM_CONSTANT(CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE);
+	BIND_ENUM_CONSTANT(CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ);
