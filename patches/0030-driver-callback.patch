 .../vulkan/rendering_device_driver_vulkan.cpp |  4 +
 servers/rendering/rendering_device.cpp        | 68 ++++++++++++++
 servers/rendering/rendering_device.h          |  8 ++
 servers/rendering/rendering_device_commons.h  |  1 +
 5 files changed, 172 insertions(+)

