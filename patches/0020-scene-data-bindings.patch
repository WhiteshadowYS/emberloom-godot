From 80d5965952b6629a4373ff6a37f79c0b4f03981a Mon Sep 17 00:00:00 2001
From: emberloom-godot <emberloom-godot@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:32:46 +0200
Subject: [PATCH 3/7] Expose temporal upscaler inputs on RenderSceneData

Bind taa_jitter, prev_taa_jitter, prev_cam_transform, prev_cam_projection,
z_near, z_far and time_step so a ViewportUpscaler or CompositorEffect written as
a GDExtension gets the jitter and history matrices on the CPU without a UBO
readback.
---
 doc/classes/RenderSceneData.xml               | 42 +++++++++++++++++++
 .../storage_rd/render_scene_data_rd.h         |  8 ++++
 .../rendering/storage/render_scene_data.cpp   |  8 ++++
 servers/rendering/storage/render_scene_data.h | 12 ++++++
 4 files changed, 70 insertions(+)

diff --git a/doc/classes/RenderSceneData.xml b/doc/classes/RenderSceneData.xml
index b412b832e9..503b9090ee 100644
--- a/doc/classes/RenderSceneData.xml
+++ b/doc/classes/RenderSceneData.xml
@@ -24,6 +24,36 @@
 				[b]Note:[/b] If more than one view is rendered, this will return a centered transform.
 			</description>
 		</method>
+		<method name="get_prev_cam_projection" qualifiers="const">
+			<return type="Projection" />
+			<description>
+				Returns the unjittered camera projection used to render the previous frame. Used by temporal upscalers to reproject history.
+			</description>
+		</method>
+		<method name="get_prev_cam_transform" qualifiers="const">
+			<return type="Transform3D" />
+			<description>
+				Returns the camera transform used to render the previous frame.
+			</description>
+		</method>
+		<method name="get_prev_taa_jitter" qualifiers="const">
+			<return type="Vector2" />
+			<description>
+				Returns the sub-pixel jitter applied to the previous frame, in the same units as [method get_taa_jitter].
+			</description>
+		</method>
+		<method name="get_taa_jitter" qualifiers="const">
+			<return type="Vector2" />
+			<description>
+				Returns the sub-pixel jitter applied to this frame's projection, in normalized device coordinates. Multiply by [code]internal_size * 0.5[/code] to get the offset in pixels (the value the built-in FSR 2 upscaler receives). [method get_cam_projection] returns the unjittered projection.
+			</description>
+		</method>
+		<method name="get_time_step" qualifiers="const">
+			<return type="float" />
+			<description>
+				Returns the time in seconds since the previous rendered frame.
+			</description>
+		</method>
 		<method name="get_uniform_buffer" qualifiers="const">
 			<return type="RID" />
 			<description>
@@ -51,5 +81,17 @@
 				[b]Note:[/b] If a single view is rendered, this returns the camera projection. If more than one view is rendered, this will return a projection for the given view including the eye offset.
 			</description>
 		</method>
+		<method name="get_z_far" qualifiers="const">
+			<return type="float" />
+			<description>
+				Returns the distance of the camera's far plane.
+			</description>
+		</method>
+		<method name="get_z_near" qualifiers="const">
+			<return type="float" />
+			<description>
+				Returns the distance of the camera's near plane.
+			</description>
+		</method>
 	</methods>
 </class>
diff --git a/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.h b/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.h
index 85a9a1e9be..2be6bf5a2b 100644
--- a/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.h
+++ b/servers/rendering/renderer_rd/storage_rd/render_scene_data_rd.h
@@ -93,6 +93,14 @@ public:
 	virtual Vector3 get_view_eye_offset(uint32_t p_view) const override;
 	virtual Projection get_view_projection(uint32_t p_view) const override;
 
+	virtual Vector2 get_taa_jitter() const override { return taa_jitter; }
+	virtual Vector2 get_prev_taa_jitter() const override { return prev_taa_jitter; }
+	virtual Transform3D get_prev_cam_transform() const override { return prev_cam_transform; }
+	virtual Projection get_prev_cam_projection() const override { return prev_cam_projection; }
+	virtual float get_z_near() const override { return z_near; }
+	virtual float get_z_far() const override { return z_far; }
+	virtual float get_time_step() const override { return time_step; }
+
 	RID create_uniform_buffer();
 	void update_ubo(RID p_uniform_buffer, RSE::ViewportDebugDraw p_debug_mode, RID p_env, RID p_reflection_probe_instance, RID p_camera_attributes, bool p_pancake_shadows, const Size2i &p_screen_size, const Size2 &p_viewport_size, const Color &p_default_bg_color, float p_luminance_multiplier, bool p_opaque_render_buffers, bool p_apply_alpha_multiplier);
 	virtual RID get_uniform_buffer() const override;
diff --git a/servers/rendering/storage/render_scene_data.cpp b/servers/rendering/storage/render_scene_data.cpp
index 0140fd3ad1..b98c4b27a7 100644
--- a/servers/rendering/storage/render_scene_data.cpp
+++ b/servers/rendering/storage/render_scene_data.cpp
@@ -41,4 +41,12 @@ void RenderSceneData::_bind_methods() {
 	ClassDB::bind_method(D_METHOD("get_view_projection", "view"), &RenderSceneData::get_view_projection);
 
 	ClassDB::bind_method(D_METHOD("get_uniform_buffer"), &RenderSceneData::get_uniform_buffer);
+
+	ClassDB::bind_method(D_METHOD("get_taa_jitter"), &RenderSceneData::get_taa_jitter);
+	ClassDB::bind_method(D_METHOD("get_prev_taa_jitter"), &RenderSceneData::get_prev_taa_jitter);
+	ClassDB::bind_method(D_METHOD("get_prev_cam_transform"), &RenderSceneData::get_prev_cam_transform);
+	ClassDB::bind_method(D_METHOD("get_prev_cam_projection"), &RenderSceneData::get_prev_cam_projection);
+	ClassDB::bind_method(D_METHOD("get_z_near"), &RenderSceneData::get_z_near);
+	ClassDB::bind_method(D_METHOD("get_z_far"), &RenderSceneData::get_z_far);
+	ClassDB::bind_method(D_METHOD("get_time_step"), &RenderSceneData::get_time_step);
 }
diff --git a/servers/rendering/storage/render_scene_data.h b/servers/rendering/storage/render_scene_data.h
index 583d5bf420..0321902c08 100644
--- a/servers/rendering/storage/render_scene_data.h
+++ b/servers/rendering/storage/render_scene_data.h
@@ -30,6 +30,9 @@
 
 #pragma once
 
+#include "core/math/projection.h"
+#include "core/math/transform_3d.h"
+#include "core/math/vector2.h"
 #include "core/object/object.h"
 
 class RenderSceneData : public Object {
@@ -47,4 +50,13 @@ public:
 	virtual Projection get_view_projection(uint32_t p_view) const = 0;
 
 	virtual RID get_uniform_buffer() const = 0;
+
+	// Temporal upscaler inputs (emberloom-godot P2). Not pure so RenderSceneDataExtension keeps compiling.
+	virtual Vector2 get_taa_jitter() const { return Vector2(); }
+	virtual Vector2 get_prev_taa_jitter() const { return Vector2(); }
+	virtual Transform3D get_prev_cam_transform() const { return Transform3D(); }
+	virtual Projection get_prev_cam_projection() const { return Projection(); }
+	virtual float get_z_near() const { return 0.0f; }
+	virtual float get_z_far() const { return 0.0f; }
+	virtual float get_time_step() const { return 0.0f; }
 };
-- 
