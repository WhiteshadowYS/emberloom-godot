+			</description>
+		</method>
 		<method name="framebuffer_create">
 			<return type="RID" />
 			<param index="0" name="textures" type="RID[]" />
@@ -1109,6 +1115,19 @@
 				[b]Note:[/b] Only available in local RenderingDevices.
 			</description>
 		</method>
+		<method name="swap_chain_interposer_is_active">
+			<return type="bool" />
+			<description>
+				Returns [code]true[/code] if an interposer is set and the last swap chain created came from it (emberloom-godot F1).
+			</description>
+		</method>
+		<method name="swap_chain_interposer_set">
+			<return type="int" enum="Error" />
+			<param index="0" name="interposer" type="int" />
+			<description>
+				Native API for GDExtensions (emberloom-godot F1, Vulkan only): [param interposer] is the address of an [code]EmberloomSwapChainInterposer[/code] ([code]drivers/vulkan/emberloom_swap_chain_interposer.h[/code]) that replaces swap chain creation, image acquisition and presentation, for example a frame generation swap chain. It must stay valid until replaced. [code]0[/code] removes it. Swap chains are recreated on the next frame; if the interposer declines, the stock swap chain is used. Other drivers return [constant ERR_UNAVAILABLE].
+			</description>
