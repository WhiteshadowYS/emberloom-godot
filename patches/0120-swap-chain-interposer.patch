+/******************************************/
+/**** SWAP CHAIN INTERPOSER (emberloom) ****/
+/******************************************/
+
+RenderingDeviceDriverVulkan::Queue *RenderingDeviceDriverVulkan::fg_game_queue = nullptr;
+thread_local bool RenderingDeviceDriverVulkan::fg_game_queue_locked = false;
+
+VkResult RenderingDeviceDriverVulkan::_fg_game_queue_submit(uint32_t p_submit_count, const VkSubmitInfo *p_submits, VkFence p_fence) {
+	Queue *queue = fg_game_queue;
+	ERR_FAIL_NULL_V(queue, VK_ERROR_INITIALIZATION_FAILED);
+	if (fg_game_queue_locked) {
+		// Called from inside the present (this thread holds the queue lock).
+		return vkQueueSubmit(queue->queue, p_submit_count, p_submits, p_fence);
+	}
+	queue->submit_mutex.lock();
+	fg_game_queue_locked = true;
+	VkResult err = vkQueueSubmit(queue->queue, p_submit_count, p_submits, p_fence);
+	fg_game_queue_locked = false;
+	queue->submit_mutex.unlock();
+	return err;
+}
+
+bool RenderingDeviceDriverVulkan::_fg_pick_queues(RenderingContextDriver::SurfaceID p_surface, CommandQueue *p_cmd_queue, EmberloomSwapChainCreateParams &r_params) {
+	const RenderingContextDriverVulkan::Functions &functions = context_driver->functions_get();
+	if (functions.GetDeviceProcAddr == nullptr) {
+		return false;
+	}
+	RenderingContextDriverVulkan::Surface *surface = (RenderingContextDriverVulkan::Surface *)(p_surface);
+	const ReservedQueue *present = nullptr;
+	const ReservedQueue *compute = nullptr;
+	// Present: a reserved queue whose family can present to this surface, graphics families first.
+	for (int pass = 0; pass < 2 && present == nullptr; pass++) {
+		for (const ReservedQueue &reserved : fg_reserved_queues) {
+			const VkQueueFlags flags = queue_family_properties[reserved.family_index].queueFlags;
+			if ((pass == 0) != ((flags & VK_QUEUE_GRAPHICS_BIT) != 0)) {
+				continue;
+			}
+			VkBool32 supported = VK_FALSE;
+			functions.GetPhysicalDeviceSurfaceSupportKHR(physical_device, reserved.family_index, surface->vk_surface, &supported);
+			if (supported) {
+				present = &reserved;
+				break;
+			}
+		}
+	}
+	if (present == nullptr) {
+		return false;
+	}
+	for (const ReservedQueue &reserved : fg_reserved_queues) {
+		if (&reserved != present && (queue_family_properties[reserved.family_index].queueFlags & VK_QUEUE_COMPUTE_BIT) != 0) {
+			compute = &reserved;
+			break;
+		}
+	}
+
+	fg_game_queue = &queue_families[p_cmd_queue->queue_family][p_cmd_queue->queue_index];
+	const EmberloomVkQueue game = { fg_game_queue->queue, p_cmd_queue->queue_family, &RenderingDeviceDriverVulkan::_fg_game_queue_submit };
+
+	r_params.version = EMBERLOOM_SWAP_CHAIN_INTERPOSER_VERSION;
+	r_params.physical_device = physical_device;
+	r_params.device = vk_device;
+	r_params.get_device_proc_addr = functions.GetDeviceProcAddr;
+	r_params.allocator = VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR);
+	r_params.game_queue = game;
+	r_params.present_queue = { present->queue, present->family_index, nullptr };
+	r_params.async_compute_queue = compute != nullptr ? EmberloomVkQueue{ compute->queue, compute->family_index, nullptr } : game;
+	r_params.async_compute_reserved = compute != nullptr ? 1 : 0;
+	r_params.image_acquire_queue = game;
+	return true;
+}
+
+Error RenderingDeviceDriverVulkan::swap_chain_interposer_set(uint64_t p_interposer) {
+	const EmberloomSwapChainInterposer *interposer = (const EmberloomSwapChainInterposer *)(uintptr_t)p_interposer;
+	ERR_FAIL_COND_V_MSG(interposer != nullptr && (interposer->version != EMBERLOOM_SWAP_CHAIN_INTERPOSER_VERSION || interposer->create == nullptr), ERR_INVALID_PARAMETER, "Unknown swap chain interposer version.");
+	if (interposer == fg_interposer) {
+		return OK;
+	}
+	fg_interposer = interposer;
+	// Every swap chain is recreated on its next acquire (RenderingDevice stalls the GPU first).
+	fg_interposer_generation++;
+	return OK;
+}
+
+bool RenderingDeviceDriverVulkan::swap_chain_interposer_is_active() {
+	return fg_interposer != nullptr && fg_last_create_interposed;
+}
+
+bool RenderingDeviceDriverVulkan::frame_generation_queues_available() {
+	return !fg_reserved_queues.is_empty();
+}
+
 bool RenderingDeviceDriverVulkan::low_latency_is_supported() {
 	return low_latency.amd_supported || low_latency.nv_supported;
 }
