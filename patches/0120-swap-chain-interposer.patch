diff --git a/drivers/vulkan/emberloom_swap_chain_interposer.h b/drivers/vulkan/emberloom_swap_chain_interposer.h
new file mode 100644
index 0000000000..f6d425e4e9
--- /dev/null
+++ b/drivers/vulkan/emberloom_swap_chain_interposer.h
@@ -0,0 +1,62 @@
+/**************************************************************************/
+/*  emberloom_swap_chain_interposer.h                                     */
+/**************************************************************************/
+/* emberloom-godot F1: a C ABI that lets a GDExtension replace the Vulkan */
+/* swap chain (vkCreateSwapchainKHR / GetSwapchainImages / Acquire /      */
+/* Present / Destroy) — e.g. the AMD FidelityFX frame generation swap     */
+/* chain. Plain C structs so the extension can mirror them in any language.*/
+/**************************************************************************/
+
+#pragma once
+
+#include "drivers/vulkan/godot_vulkan.h"
+
+#define EMBERLOOM_SWAP_CHAIN_INTERPOSER_VERSION 1
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Same layout as FidelityFX's VkQueueInfoFFXAPI: { queue, family index, optional submit replacement }.
+typedef VkResult (*EmberloomQueueSubmitFn)(uint32_t p_submit_count, const VkSubmitInfo *p_submits, VkFence p_fence);
+typedef struct EmberloomVkQueue {
+	VkQueue queue;
+	uint32_t family_index;
+	// Non-null for a queue Godot also submits to: takes Godot's queue lock (re-entrant from the present call).
+	EmberloomQueueSubmitFn submit;
+} EmberloomVkQueue;
+
+typedef struct EmberloomSwapChainCreateParams {
+	uint32_t version; // EMBERLOOM_SWAP_CHAIN_INTERPOSER_VERSION
+	VkPhysicalDevice physical_device;
+	VkDevice device;
+	PFN_vkGetDeviceProcAddr get_device_proc_addr;
+	const VkSwapchainCreateInfoKHR *create_info; // oldSwapchain is always VK_NULL_HANDLE (Godot releases first).
+	const VkAllocationCallbacks *allocator;
+	EmberloomVkQueue game_queue; // The queue Godot submits the frame and presents on (locked submit).
+	EmberloomVkQueue present_queue; // Reserved for the interposer; supports present to this surface. Godot never uses it.
+	EmberloomVkQueue async_compute_queue; // Reserved compute queue when async_compute_reserved, else the game queue.
+	EmberloomVkQueue image_acquire_queue; // The game queue (locked submit).
+	uint32_t async_compute_reserved;
+} EmberloomSwapChainCreateParams;
+
+typedef struct EmberloomSwapChainFunctions {
+	PFN_vkGetSwapchainImagesKHR get_swapchain_images;
+	PFN_vkAcquireNextImageKHR acquire_next_image;
+	PFN_vkQueuePresentKHR queue_present;
+	// Replaces vkDestroySwapchainKHR; called after the GPU is idle for the swap chain's frames.
+	void (*destroy)(void *p_user, VkDevice p_device, VkSwapchainKHR p_swapchain, const VkAllocationCallbacks *p_allocator);
+	void *destroy_user;
+} EmberloomSwapChainFunctions;
+
+typedef struct EmberloomSwapChainInterposer {
+	uint32_t version; // EMBERLOOM_SWAP_CHAIN_INTERPOSER_VERSION
+	void *user;
+	// Replaces vkCreateSwapchainKHR. VK_SUCCESS → *r_swapchain + every member of *r_functions set. Any error →
+	// Godot creates a stock swap chain for this surface (and logs the result).
+	VkResult (*create)(void *p_user, const EmberloomSwapChainCreateParams *p_params, VkSwapchainKHR *r_swapchain, EmberloomSwapChainFunctions *r_functions);
+} EmberloomSwapChainInterposer;
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/drivers/vulkan/rendering_device_driver_vulkan.cpp b/drivers/vulkan/rendering_device_driver_vulkan.cpp
index c139a1a1ff..8f3bd11dfa 100644
--- a/drivers/vulkan/rendering_device_driver_vulkan.cpp
+++ b/drivers/vulkan/rendering_device_driver_vulkan.cpp
@@ -1338,7 +1338,12 @@ Error RenderingDeviceDriverVulkan::_add_queue_create_info(LocalVector<VkDeviceQu
 
 	VkQueueFlags queue_flags_mask = VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT | VK_QUEUE_TRANSFER_BIT;
 	const uint32_t max_queue_count_per_family = 1;
-	static const float queue_priorities[max_queue_count_per_family] = {};
+	// emberloom-godot F1: with rendering/rendering_device/vulkan/reserve_frame_generation_queues, every family that
+	// has a second queue gets one more, kept out of Godot's own queue pool for a swap chain interposer (frame
+	// generation: present / async compute). Godot's queues stay exactly as before.
+	fg_reserve_queues = GLOBAL_GET("rendering/rendering_device/vulkan/reserve_frame_generation_queues");
+	fg_reserved_queues.clear();
+	static const float queue_priorities[max_queue_count_per_family + 1] = {};
 	for (uint32_t i = 0; i < queue_family_count; i++) {
 		if ((queue_family_properties[i].queueFlags & queue_flags_mask) == 0) {
 			// We ignore creating queues in families that don't support any of the operations we require.
@@ -1350,10 +1355,17 @@ Error RenderingDeviceDriverVulkan::_add_queue_create_info(LocalVector<VkDeviceQu
 		create_info.queueFamilyIndex = i;
 		create_info.queueCount = MIN(queue_family_properties[i].queueCount, max_queue_count_per_family);
 		create_info.pQueuePriorities = queue_priorities;
-		r_queue_create_info.push_back(create_info);
 
 		// Prepare the vectors where the queues will be filled out.
 		queue_families[i].resize(create_info.queueCount);
+
+		if (fg_reserve_queues && queue_family_properties[i].queueCount > create_info.queueCount) {
+			ReservedQueue reserved;
+			reserved.family_index = i;
+			fg_reserved_queues.push_back(reserved);
+			create_info.queueCount++;
+		}
+		r_queue_create_info.push_back(create_info);
 	}
 
 	return OK;
@@ -1653,6 +1665,14 @@ Error RenderingDeviceDriverVulkan::_initialize_device(const LocalVector<VkDevice
 		}
 	}
 
+	// emberloom-godot F1: the reserved queue is the one after Godot's in its family.
+	for (ReservedQueue &reserved : fg_reserved_queues) {
+		vkGetDeviceQueue(vk_device, reserved.family_index, queue_families[reserved.family_index].size(), &reserved.queue);
+	}
+	if (!fg_reserved_queues.is_empty()) {
+		print_verbose(vformat("Vulkan: %d queue(s) reserved for a swap chain interposer (frame generation).", fg_reserved_queues.size()));
+	}
+
 	const RenderingContextDriverVulkan::Functions &functions = context_driver->functions_get();
 	if (functions.GetDeviceProcAddr != nullptr) {
 		// Low latency (emberloom-godot L1).
@@ -3498,7 +3518,9 @@ Error RenderingDeviceDriverVulkan::command_queue_execute_and_present(CommandQueu
 				low_latency_frame = low_latency.frame_id;
 				low_latency.presented_frame_id = low_latency_frame;
 				low_latency_amd = low_latency.amd_supported;
-				if (low_latency.nv_supported) {
+				// NV latency calls take the driver swap chain: an interposed one (F1) is not, so the NV mode
+				// stays inactive while an interposer owns the main swap chain.
+				if (low_latency.nv_supported && !((SwapChain *)(p_swap_chains[0].id))->interposed) {
 					if (low_latency.nv_swapchain != swapchains[0]) {
 						low_latency.nv_swapchain = swapchains[0];
 						low_latency.nv_mode_dirty = true;
@@ -3524,16 +3546,53 @@ Error RenderingDeviceDriverVulkan::command_queue_execute_and_present(CommandQueu
 			present_info.pNext = &present_id_info;
 		}
 
-		device_queue.submit_mutex.lock();
-#if defined(SWAPPY_FRAME_PACING_ENABLED)
-		if (swappy_frame_pacer_enable) {
-			err = SwappyVk_queuePresent(device_queue.queue, &present_info);
-		} else {
-			err = device_functions.QueuePresentKHR(device_queue.queue, &present_info);
+		// Swap chain interposer (emberloom-godot F1): an interposed swap chain is presented through its own
+		// function, one swap chain per call (the handle is not a driver swap chain). The interposer may submit
+		// to this queue from inside the call through the locked submit, so mark the lock as held here.
+		bool any_interposed = false;
+		for (uint32_t i = 0; i < p_swap_chains.size(); i++) {
+			any_interposed = any_interposed || ((SwapChain *)(p_swap_chains[i].id))->interposed;
 		}
+
+		device_queue.submit_mutex.lock();
+		if (any_interposed) {
+			fg_game_queue_locked = true;
+			present_info.pNext = nullptr; // No VkPresentIdKHR through the interposer (its own presents carry none).
+			err = VK_SUCCESS;
+			for (uint32_t i = 0; i < p_swap_chains.size(); i++) {
+				SwapChain *swap_chain = (SwapChain *)(p_swap_chains[i].id);
+				VkPresentInfoKHR single_info = present_info;
+				// Only the first present waits: binary semaphores are consumed once, and later presents on the
+				// same queue are ordered after it. Multi-window + interposer is not a supported setup.
+				single_info.waitSemaphoreCount = i == 0 ? present_info.waitSemaphoreCount : 0;
+				single_info.pWaitSemaphores = i == 0 ? present_info.pWaitSemaphores : nullptr;
+				single_info.swapchainCount = 1;
+				single_info.pSwapchains = &swapchains[i];
+				single_info.pImageIndices = &image_indices[i];
+				// `results` is reused thread_local storage: a replacement present may not write pResults.
+				results[i] = VK_SUCCESS;
+				single_info.pResults = &results[i];
+				const PFN_vkQueuePresentKHR queue_present = swap_chain->interposed ? swap_chain->interposed_functions.queue_present : device_functions.QueuePresentKHR;
+				VkResult single_err = queue_present(device_queue.queue, &single_info);
+				if (single_err != VK_SUCCESS && results[i] == VK_SUCCESS) {
+					results[i] = single_err;
+				}
+				if (single_err != VK_SUCCESS && err == VK_SUCCESS) {
+					err = single_err;
+				}
+			}
+			fg_game_queue_locked = false;
+		} else {
+#if defined(SWAPPY_FRAME_PACING_ENABLED)
+			if (swappy_frame_pacer_enable) {
+				err = SwappyVk_queuePresent(device_queue.queue, &present_info);
+			} else {
+				err = device_functions.QueuePresentKHR(device_queue.queue, &present_info);
+			}
 #else
-		err = device_functions.QueuePresentKHR(device_queue.queue, &present_info);
+			err = device_functions.QueuePresentKHR(device_queue.queue, &present_info);
 #endif
+		}
 
 		device_queue.submit_mutex.unlock();
 
@@ -3864,8 +3923,14 @@ void RenderingDeviceDriverVulkan::_swap_chain_release(SwapChain *swap_chain) {
 				low_latency.nv_mode_dirty = true;
 			}
 		}
-		device_functions.DestroySwapchainKHR(vk_device, swap_chain->vk_swapchain, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR));
+		if (swap_chain->interposed) {
+			swap_chain->interposed_functions.destroy(swap_chain->interposed_functions.destroy_user, vk_device, swap_chain->vk_swapchain, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR));
+		} else {
+			device_functions.DestroySwapchainKHR(vk_device, swap_chain->vk_swapchain, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR));
+		}
 		swap_chain->vk_swapchain = VK_NULL_HANDLE;
+		swap_chain->interposed = false;
+		swap_chain->interposed_functions = {};
 	}
 
 	if (swap_chain->render_pass.id != 0) {
@@ -4080,8 +4145,42 @@ Error RenderingDeviceDriverVulkan::swap_chain_resize(CommandQueueID p_cmd_queue,
 		latency_create_info.latencyModeEnable = VK_TRUE;
 		swap_create_info.pNext = &latency_create_info;
 	}
-	err = device_functions.CreateSwapchainKHR(vk_device, &swap_create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR), &swap_chain->vk_swapchain);
+	// Swap chain interposer (emberloom-godot F1): offer the creation to the interposer first; any failure falls
+	// back to the stock swap chain.
+	swap_chain->interposer_generation = fg_interposer_generation;
+	swap_chain->interposed = false;
+	swap_chain->interposed_functions = {};
+	err = VK_ERROR_INITIALIZATION_FAILED;
+	if (fg_interposer != nullptr) {
+		EmberloomSwapChainCreateParams params = {};
+		if (_fg_pick_queues(swap_chain->surface, command_queue, params)) {
+			params.create_info = &swap_create_info;
+			EmberloomSwapChainFunctions functions_out = {};
+			VkSwapchainKHR interposed_swapchain = VK_NULL_HANDLE;
+			err = fg_interposer->create(fg_interposer->user, &params, &interposed_swapchain, &functions_out);
+			if (err == VK_SUCCESS && (interposed_swapchain == VK_NULL_HANDLE || functions_out.get_swapchain_images == nullptr || functions_out.acquire_next_image == nullptr || functions_out.queue_present == nullptr || functions_out.destroy == nullptr)) {
+				ERR_PRINT("Vulkan: the swap chain interposer returned an incomplete swap chain; using the stock one.");
+				if (interposed_swapchain != VK_NULL_HANDLE && functions_out.destroy != nullptr) {
+					functions_out.destroy(functions_out.destroy_user, vk_device, interposed_swapchain, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR));
+				}
+				err = VK_ERROR_INITIALIZATION_FAILED;
+			} else if (err == VK_SUCCESS) {
+				swap_chain->vk_swapchain = interposed_swapchain;
+				swap_chain->interposed = true;
+				swap_chain->interposed_functions = functions_out;
+			} else {
+				print_line(vformat("Vulkan: the swap chain interposer declined (VkResult %d); using the stock swap chain.", err));
+			}
+		} else {
+			print_line("Vulkan: no reserved present queue for the swap chain interposer; using the stock swap chain.");
+		}
+	}
+	fg_last_create_interposed = swap_chain->interposed;
+	if (!swap_chain->interposed) {
+		err = device_functions.CreateSwapchainKHR(vk_device, &swap_create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SWAPCHAIN_KHR), &swap_chain->vk_swapchain);
+	}
 	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS, ERR_CANT_CREATE, vformat("Couldn't create Vulkan swapchain (VkResult error %d).", err));
+	const PFN_vkGetSwapchainImagesKHR get_swapchain_images = swap_chain->interposed ? swap_chain->interposed_functions.get_swapchain_images : device_functions.GetSwapchainImagesKHR;
 
 #if defined(SWAPPY_FRAME_PACING_ENABLED)
 	if (swappy_frame_pacer_enable) {
@@ -4114,11 +4213,11 @@ Error RenderingDeviceDriverVulkan::swap_chain_resize(CommandQueueID p_cmd_queue,
 #endif
 
 	uint32_t image_count = 0;
-	err = device_functions.GetSwapchainImagesKHR(vk_device, swap_chain->vk_swapchain, &image_count, nullptr);
+	err = get_swapchain_images(vk_device, swap_chain->vk_swapchain, &image_count, nullptr);
 	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS, ERR_CANT_CREATE, vformat("Couldn't get Vulkan swapchain images (VkResult error %d).", err));
 
 	swap_chain->images.resize(image_count);
-	err = device_functions.GetSwapchainImagesKHR(vk_device, swap_chain->vk_swapchain, &image_count, swap_chain->images.ptr());
+	err = get_swapchain_images(vk_device, swap_chain->vk_swapchain, &image_count, swap_chain->images.ptr());
 	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS, ERR_CANT_CREATE, vformat("Couldn't get Vulkan swapchain images (VkResult error %d).", err));
 
