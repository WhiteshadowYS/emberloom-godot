+static void _hudless_layout_callback(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_command_buffer, void *p_userdata) {
+	// Nothing to record: declaring the HUD-less copy as sampled makes the render graph leave it in the
+	// shader-read layout at the end of the frame, where a frame generation swap chain reads it at present.
+}
+
+void RendererViewport::viewport_set_hudless_capture(RID p_viewport, bool p_enabled) {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL(viewport);
+
+	viewport->hudless_capture = p_enabled && RD::get_singleton() != nullptr;
+	if (!viewport->hudless_capture) {
+		_free_hudless(viewport);
+	}
+}
+
+RID RendererViewport::viewport_get_hudless_texture(RID p_viewport) const {
+	const Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL_V(viewport, RID());
+	return viewport->hudless_texture;
+}
+
+void RendererViewport::_free_hudless(Viewport *p_viewport) {
+	if (p_viewport->hudless_texture.is_valid() && RD::get_singleton() != nullptr) {
+		RD::get_singleton()->free_rid(p_viewport->hudless_texture);
+	}
+	p_viewport->hudless_texture = RID();
+}
+
+void RendererViewport::_capture_hudless(Viewport *p_viewport) {
+	RenderingDevice *rd = RD::get_singleton();
+	if (!p_viewport->hudless_capture || rd == nullptr) {
+		return;
+	}
+	const RID src = RSG::texture_storage->texture_get_rd_texture(RSG::texture_storage->render_target_get_texture(p_viewport->render_target));
+	if (src.is_null() || !rd->texture_is_valid(src)) {
+		return;
+	}
+	const RD::TextureFormat src_format = rd->texture_get_format(src);
+	if (p_viewport->hudless_texture.is_valid()) {
+		const RD::TextureFormat cur = rd->texture_get_format(p_viewport->hudless_texture);
+		if (cur.width != src_format.width || cur.height != src_format.height || cur.format != src_format.format) {
+			_free_hudless(p_viewport);
+		}
+	}
+	if (p_viewport->hudless_texture.is_null()) {
+		RD::TextureFormat format;
+		format.format = src_format.format;
+		format.width = src_format.width;
+		format.height = src_format.height;
+		format.texture_type = RD::TEXTURE_TYPE_2D;
+		format.usage_bits = RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT;
+		p_viewport->hudless_texture = rd->texture_create(format, RD::TextureView());
+		ERR_FAIL_COND(p_viewport->hudless_texture.is_null());
+		rd->set_resource_name(p_viewport->hudless_texture, "HUD-less copy");
+	}
+	rd->texture_copy(src, p_viewport->hudless_texture, Vector3(), Vector3(), Vector3(src_format.width, src_format.height, 1), 0, 0, 0, 0);
+	RD::CallbackResource resource;
+	resource.rid = p_viewport->hudless_texture;
+	resource.type = RD::CALLBACK_RESOURCE_TYPE_TEXTURE;
+	resource.usage = RD::CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE;
+	rd->driver_callback_add(&_hudless_layout_callback, nullptr, VectorView<RD::CallbackResource>(&resource, 1));
+}
